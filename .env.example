# Optional. Copy to ".env" to override the defaults.
# No API key needed: emails are written by a local Ollama model (free).

# Model used for the emails (run "ollama pull <model>" once).
# llama3 works, but German is usually better with qwen2.5:7b or llama3.1:8b.
OLLAMA_MODEL=llama3

# Where Ollama is running.
OLLAMA_HOST=http://localhost:11434
